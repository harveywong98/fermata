  "components": {
    "schemas": {
      "Body_upload_api_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "knowledge_base": {
            "type": "string",
            "title": "Knowledge Base",
            "default": "电力"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_documents_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PublishRequest": {
        "properties": {
          "preview_id": {
            "type": "string",
            "format": "uuid",
            "title": "Preview Id"
          }
        },
        "type": "object",
        "required": [
          "preview_id"
        ],
        "title": "PublishRequest"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "knowledge_base": {
            "type": "string",
            "title": "Knowledge Base",
            "default": "电力"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SplitRequest": {
        "properties": {
          "size": {
            "type": "integer",
            "maximum": 480.0,
            "minimum": 128.0,
            "title": "Size",
            "default": 400
          },
          "overlap": {
            "type": "integer",
            "maximum": 80.0,
            "minimum": 0.0,
            "title": "Overlap",
            "default": 40
          }
        },
        "type": "object",
        "title": "SplitRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
