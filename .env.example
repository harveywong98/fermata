# 所有应用配置集中在项目根目录；Agent 模型接入仍为 TODO。
MODEL_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=
KNOWLEDGE_BASE=电力
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/privacy_knowledge_demo
EMBEDDING_URL=http://127.0.0.1:18087
# 本地数据与模型目录，不纳入 Git。
KNOWLEDGE_DATA_DIR=rag/data
KNOWLEDGE_MODEL_DIR=rag/models

# Compose 本地 Langfuse；留空使用 compose/langfuse.yaml 的开发默认值。
# 首次启动前可替换；已有数据后不要随意更换加密密钥或数据库密码。
LANGFUSE_IMAGE_TAG=4
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
# 自定义时用 openssl rand -hex 32 生成。
LANGFUSE_ENCRYPTION_KEY=
