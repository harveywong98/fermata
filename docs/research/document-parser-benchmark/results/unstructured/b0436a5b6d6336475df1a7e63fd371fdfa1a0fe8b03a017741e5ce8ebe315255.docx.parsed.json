{"blocks": [{"type": "UncategorizedText", "element_id": "35a5ba81c9747395a845f319c7988772", "text": "集群部署", "metadata": {"category_depth": 0, "emphasized_text_contents": ["集群部署"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "552cf8c6565b388a70eb762ef7fd08c8", "text": "一、组件关系介绍", "metadata": {"category_depth": 0, "emphasized_text_contents": ["一、组件关系介绍"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "4b40f0e5eb4353c03b8c2fa309b29ace", "text": "二、防火墙开放端口", "metadata": {"category_depth": 0, "emphasized_text_contents": ["二、防火墙开放端口"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "0ee3d7665af7802d4e2fb59d374148ae", "text": "主节点需要向从节点开放端口如下：\n9000 8123 7800 9010 9066 5432 6380 2379 8092 7781\n\n从节点需要向主节点开放端口如下：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "efb9721b4f956e805577db72de18f652", "text": "8123 9000 7800", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "27f49f8b725aa54dde35b37e52faf04b", "text": "三、部署", "metadata": {"category_depth": 0, "emphasized_text_contents": ["三、部署"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "8e3d2cb3cd855a9b63cf8f4d3375ee52", "text": "用两台机器做例子：123.57.105.232（主）、123.249.127.100（从）", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "NarrativeText", "element_id": "7da13520eab9145d2c2ffa314a0a8232", "text": "㈠ 分别部署两台机器", "metadata": {"category_depth": 0, "emphasized_text_contents": ["㈠ 分别部署两台机器"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "1b7fc1f26282e280082adfa9229e02b0", "text": "部署工作步骤记录按这个手册正常部署就行", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "20ccf738944e6b0dc1dd67dc30d859f7", "text": "㈡ 集群配置", "metadata": {"category_depth": 0, "emphasized_text_contents": ["㈡ 集群配置"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "07a30f1b205a02d076efaa128a29a546", "text": "㊀ 主 123.57.105.232", "metadata": {"category_depth": 0, "emphasized_text_contents": ["㊀ 主", "123.57.105.232"], "emphasized_text_tags": ["b", "b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "851b1a5a76ad7efb4a2d9a456d99696e", "text": "❶ 主节点 askv(redis)", "metadata": {"category_depth": 0, "emphasized_text_contents": ["❶ 主节点 askv(redis)"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "9b6643e54dfa436599605d14b756a254", "text": "YAML\ncommand:\n  - \"--cluster-announce-ip 123.57.105.232\"  # 不然从节点连不上", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>YAML command: - &quot;--cluster-announce-ip 123.57.105.232&quot; # 不然从节点连不上</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "29ceee7209d801d655b65e7f842fbc11", "text": "❷ 主节点 asdb", "metadata": {"category_depth": 0, "emphasized_text_contents": ["❷ 主节点 asdb"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "NarrativeText", "element_id": "336aa6ad82a9dc40e7503540a6aa61e0", "text": "确认 asdb 集群分片和备份的数量，添加 asdb 容器的环境变量 CLUSTER_SHARDS_NUM、CLUSTER_REPLICAS_NUM；", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "NarrativeText", "element_id": "a88f768ba49f129611eb603735b61482", "text": "我们这里以「多分片」模式介绍，多分片无备份。Asdb 分布式介绍", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "b55f0134cb6a2ff19763744ded72183e", "text": "YAML\nclickhouse:\n  extra_hosts:\n    - \"sw-postgres:123.57.105.232\"   # asdb 中执行 show create risk_dict; 可以看到建表语句使用的 host 是这里定义的 sw-postgres\n    - \"sw-tequila:123.57.105.232\"\n    - \"sw-sheikah:123.57.105.232\"\n    - \"ck-node-shard1-replica1:123.249.127.100\"  # 分片1\n    - \"ck-node-shard2-replica1:123.57.105.232\"  # 分片2\n  environment:\n    - CLICKHOUSE_PASSWORD=Sw@123456\n    - CLUSTER_SHARDS_NUM=2        # 集群分片数\n    #- CLUSTER_REPLICAS_NUM=1     # 集群备份数", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>YAML clickhouse: extra_hosts: - &quot;sw-postgres:123.57.105.232&quot; # asdb 中执行 show create risk_dict; 可以看到建表语句使用的 host 是这里定义的 sw-postgres - &quot;sw-tequila:123.57.105.232&quot; - &quot;sw-sheikah:123.57.105.232&quot; - &quot;ck-node-shard1-replica1:123.249.127.100&quot; # 分片1 - &quot;ck-node-shard2-replica1:123.57.105.232&quot; # 分片2 environment: - CLICKHOUSE_PASSWORD=Sw@123456 - CLUSTER_SHARDS_NUM=2 # 集群分片数 #- CLUSTER_REPLICAS_NUM=1 # 集群备份数</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "4173303ccb95f02fead5c1883594ba57", "text": "❸ 主节点 tequila", "metadata": {"category_depth": 0, "emphasized_text_contents": ["❸ 主节点 tequila"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "f00216435d0a680dccee087f84f94684", "text": "YAML\ntequila:\n  environment:\n    - TEQUILA_CLICKHOUSE_NODES=123.57.105.232,123.249.127.100 # clickhouse节点", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>YAML tequila: environment: - TEQUILA_CLICKHOUSE_NODES=123.57.105.232,123.249.127.100 # clickhouse节点</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "f875d49f3fc8fd1346e36296a02b5b3d", "text": "执行 docker exec -it sw_asdb /opt/sw/bin/cluster_config.sh  批量修改物化视图引擎", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "fb4be1f96c425ede34df8ce5b5b018c4", "text": "㊁ 从 123.249.127.100", "metadata": {"category_depth": 0, "emphasized_text_contents": ["㊁ 从", "123.249.127.100"], "emphasized_text_tags": ["b", "b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "226830a5fe8ddb9a398202a861c75504", "text": "❶ whisky", "metadata": {"category_depth": 0, "emphasized_text_contents": ["❶ whisky"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "caf72d731f135cc3a5b034d605c58099", "text": "YAML\nwhisky:\n  environment:\n    - ETCD_ENDPOINTS=123.57.105.232:2379          # 主节点etcd\n    - PROCESS_REDIS_ADDRESSES=123.57.105.232:6380 # 主节点askv\n    - PROCESS_REDIS_PASSWORD=Sw@123456           # 主节点askv密码\n    - MQ_REDIS_ADDRESSES=127.0.0.1:6380          # 本机askv\n    - MQ_REDIS_PASSWORD=Sw@123456                # 本机askv密码\n    - PROCESS_SHEIKAH=http://123.57.105.232:9010  # 主节点sheikah", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>YAML whisky: environment: - ETCD_ENDPOINTS=123.57.105.232:2379 # 主节点etcd - PROCESS_REDIS_ADDRESSES=123.57.105.232:6380 # 主节点askv - PROCESS_REDIS_PASSWORD=Sw@123456 # 主节点askv密码 - MQ_REDIS_ADDRESSES=127.0.0.1:6380 # 本机askv - MQ_REDIS_PASSWORD=Sw@123456 # 本机askv密码 - PROCESS_SHEIKAH=http://123.57.105.232:9010 # 主节点sheikah</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "7d10c697321882ea1c69f82b3b87f43c", "text": "❷ tequila", "metadata": {"category_depth": 0, "emphasized_text_contents": ["❷ tequila"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "bb1cc0d7c73cfbed6841fe1292583ce6", "text": "YAML\ntequila:\n  environment:\n    - TEQUILA_OPTIONS_DISABLETASK=true                  # 关闭批量任务\n    - TEQUILA_SHEIKAH_URL=http://123.57.105.232:9010     # 主节点sheikah\n    - TEQUILA_SHERRYTI_URL=http://123.57.105.232:8092/ti # 主节点情报组件\n    - TEQUILA_ETCD_ENDPOINTS=123.57.105.232:2379         # 主节点etcd\n    - TEQUILA_REDIS_HOST=123.57.105.232:6380             # 主节点askv", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>YAML tequila: environment: - TEQUILA_OPTIONS_DISABLETASK=true # 关闭批量任务 - TEQUILA_SHEIKAH_URL=http://123.57.105.232:9010 # 主节点sheikah - TEQUILA_SHERRYTI_URL=http://123.57.105.232:8092/ti # 主节点情报组件 - TEQUILA_ETCD_ENDPOINTS=123.57.105.232:2379 # 主节点etcd - TEQUILA_REDIS_HOST=123.57.105.232:6380 # 主节点askv</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "64483d41f61d73ba1b0aa295c06009d8", "text": "❸ maiar", "metadata": {"category_depth": 0, "emphasized_text_contents": ["❸ maiar"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "d8ca22bf0fb7de7e397ee62239a20342", "text": "YAML\nmaiar:\n  environment:\n    - ETCD_ENDPOINTS=123.57.105.232:2379 # 主节点etcd", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>YAML maiar: environment: - ETCD_ENDPOINTS=123.57.105.232:2379 # 主节点etcd</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedTex