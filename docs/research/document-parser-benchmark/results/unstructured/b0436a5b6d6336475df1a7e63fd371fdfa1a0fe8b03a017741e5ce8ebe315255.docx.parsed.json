cument"}}, {"type": "Table", "element_id": "04b67d280b642d0e640e3e7ba32a0422", "text": "Plain Text\ncurl 127.0.0.1:8088/as_ping               # 在主节点 curl 十次、在系统里创建几条流量\ndocker exec -it sw_asdb clickhouse-client # 分别进入两个节点的数据库\nselect ip,host,url from access_local;     # 在数据库中执行这条SQL，两个节点都应该有流量，且加起来是十条", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "text_as_html": "<table><tr><td>Plain Text curl 127.0.0.1:8088/as_ping # 在主节点 curl 十次、在系统里创建几条流量 docker exec -it sw_asdb clickhouse-client # 分别进入两个节点的数据库 select ip,host,url from access_local; # 在数据库中执行这条SQL，两个节点都应该有流量，且加起来是十条</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "8fd675b6667ff55f26c861fa60d27335", "text": "三、疑问", "metadata": {"category_depth": 0, "emphasized_text_contents": ["三、疑问"], "emphasized_text_tags": ["b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "ListItem", "element_id": "007d111723915fbcdbb799bafc462af6", "text": "1. askv 挂掉怎么办", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "b0436a5b6d6336475df1a7e63fd371fdfa1a0fe8b03a017741e5ce8ebe315255.docx", "last_modified": "2026-08-28T10:09:08", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.documen