{"blocks": [{"type": "UncategorizedText", "element_id": "d03cdbfb70a81ec03a287e5c8daf8d35", "text": "唯品会 IP访问敏感数据数量", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "a35483d3fad837a7ef7ebc66fc70ec4c", "text": "2025-02-19 17:02 Wed", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Normal", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "151ab46a0d51a1a21e085b01f7d1c678", "text": "一、请求字段", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Heading 1", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "3f034fa050a52bd0cf69401126d84c54", "text": "字段名 字段描述 字段样例 host 域名 sso.example.com res_sens_map 响应敏感及敏感值去重数 {'手机':40,'身份证':10,'银行卡':34}", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "text_as_html": "<table><tr><td>字段名</td><td>字段描述</td><td>字段样例</td></tr><tr><td>host</td><td>域名</td><td>sso.example.com</td></tr><tr><td>res_sens_map</td><td>响应敏感及敏感值去重数</td><td>{&#x27;手机&#x27;:40,&#x27;身份证&#x27;:10,&#x27;银行卡&#x27;:34}</td></tr></table>", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "151ab46a0d51a1a21e085b01f7d1c678"}}, {"type": "UncategorizedText", "element_id": "f5b31516721534590c668fa079059d9c", "text": "{\n  \"code\": 200,\n  \"data\": [\n    {\n      \"host\": \"192.168.0.65\",\n      \"res_sens_map\": {\n        \"地址(详细)\": \"7\",\n        \"手机\": \"165\",\n        \"身份证\": \"70\",\n        \"身份证(未成年)\": \"9\",\n        \"银行卡\": \"58\"\n      }\n    },\n    {\n      \"host\": \"[1000:1::5]\",\n      \"res_sens_map\": {\n        \"手机\": \"10\",\n        \"身份证\": \"10\",\n        \"身份证(未成年)\": \"10\"\n      }\n    }\n  ]\n}", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Source Code", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "151ab46a0d51a1a21e085b01f7d1c678"}}, {"type": "Title", "element_id": "83ea0256c0e6a7c9fbe7a2db9627769d", "text": "二、ETCD 添加接口", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Heading 1", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "NarrativeText", "element_id": "a6e3987cc2895f8ae99c2499390a1e57", "text": "{\n  \"APIs\": [\n    {\n      \"Name\": \"vip_ip_sens\",\n      \"Sql\": \"SELECT host, uniqMapMerge(res_sens_mp_state) res_sens_map FROM ( SELECT host, uniqMapState(mapFilter((k, v) -> (k IN ['手机', '银行卡', '身份证', '身份证(未成年)', '地址(详细)']), mapFromArrays(res_sens_k, res_sens_v))) res_sens_mp_state FROM access WHERE org <> 'no_res' AND (ts >= toDateTime('{{ .start_ts }}', 'Asia/Shanghai') AND ts < toDateTime('{{ .end_ts }}', 'Asia/Shanghai')) AND length(res_sens_k) > 0 AND ip = '{{ .ip }}' AND If('{{ .host }}' AS inputHost = '<no value>', 1, host = inputHost) AND If('{{ .user }}' AS inputUser = '<no value>', 1, uid = inputUser) GROUP BY host ) GROUP BY host HAVING length(res_sens_map) > 0 FORMAT JSON SETTINGS max_execution_time=180\",\n      \"Template\": \"{ \\\"code\\\": {{.Status}}, \\\"data\\\": {{.Data}} }\"\n    }\n  ]\n}", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Source Code", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "83ea0256c0e6a7c9fbe7a2db9627769d"}}, {"type": "Title", "element_id": "2327c5779e290a2c0aeb23a2b88deaf2", "text": "三、查询语句", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Heading 1", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "NarrativeText", "element_id": "80f2abee03300a21495ce1005fb80d26", "text": "SELECT\n    host,\n    uniqMapMerge(res_sens_mp_state) res_sens_map\nFROM (\n    SELECT\n        host,\n        uniqMapState(mapFilter((k, v) -> (k IN ['手机', '银行卡', '身份证', '身份证(未成年)', '地址(详细)']), mapFromArrays(res_sens_k, res_sens_v))) res_sens_mp_state\n    FROM access\n    WHERE org <> 'no_res'\n      AND (ts >= toDateTime('{{ .start_ts }}', 'Asia/Shanghai') AND ts < toDateTime('{{ .end_ts }}', 'Asia/Shanghai'))\n      AND length(res_sens_k) > 0\n      AND ip = '{{ .ip }}'\n      AND If('{{ .host }}' AS inputHost = '<no value>', 1, host = inputHost)\n      AND If('{{ .user }}' AS inputUser = '<no value>', 1, uid = inputUser)\n      AND If('{{ .token }}' AS inputToken = '<no value>', 1, ext_id[1] = inputToken)\n    GROUP BY host\n)\nGROUP BY host\nHAVING length(res_sens_map) > 0\nLIMIT 5000\nFORMAT JSON\nSETTINGS max_execution_time=180", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Source Code", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "2327c5779e290a2c0aeb23a2b88deaf2"}}, {"type": "Title", "element_id": "8ee87329adc899fcea959bbc6ab9c309", "text": "四、调用方式", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Heading 1", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "968cae9bb1740b17add7a5951a4c3b05", "text": "㊀、开启 sheikah 无验证码接口 LOGIN_BASICAPI_ENABLE", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Heading 2", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8ee87329adc899fcea959bbc6ab9c309"}}, {"type": "UncategorizedText", "element_id": "138d281e49e9db87db8f3246a42b7ca9", "text": "curl -X POST \"10.218.57.238:9010/auth/login\" -d \"{\\\"username\\\": \\\"api.tequila\\\", \\\"password\\\": \\\"ZeYQbb1u8qWzG6j78x4pNpTF7oxUVLwVVpOf3F2Wy7vljpP80JwfnM14DtgdrHK0EBcLj2zW9Q3xbs5Q2LwJFQ==\\\"}\"", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Source Code", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "968cae9bb1740b17add7a5951a4c3b05"}}, {"type": "UncategorizedText", "element_id": "15f5853eb0f2c02c079b0034eb33a1ea", "text": "发送请求，拿到 token，token 有过期时间，过期时间内可以重复使用，不可以长期使用。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Body Text", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "968cae9bb1740b17add7a5951a4c3b05"}}, {"type": "UncategorizedText", "element_id": "06a25299402cb33829c98085baf3f6f2", "text": "（这个 api.tequila 是给接口使用而创建的一个用户，可以在用户管理中看到）", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Body Text", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "968cae9bb1740b17add7a5951a4c3b05"}}, {"type": "Title", "element_id": "b976d5d2f71c07c365d015cee04a06eb", "text": "㊁、使用 token，获取 IP 敏感信息", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Heading 2", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8ee87329adc899fcea959bbc6ab9c309"}}, {"type": "UncategorizedText", "element_id": "b52c49e70dfef25224134710a0d10800", "text": "curl -X POST \"10.218.57.238:9010/tequila/v2/load\" -H \"Cookie: sw_sheikah=eyJhbGciOiJIUzI...\" -d \"{\\\"name\\\": \\\"vip_ip_sens\\\", \\\"start_ts\\\": \\\"2025-02-19 00:00:01\\\", \\\"end_ts\\\": \\\"2025-02-19 23:59:59\\\", \\\"ip\\\": \\\"127.0.0.1\\\"}\"", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Source Code", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "b976d5d2f71c07c365d015cee04a06eb"}}, {"type": "UncategorizedText", "element_id": "70fbe8f0051b635f3122f3066ce5257d", "text": "在 Cookie 中携带上一步中获取的 token： sw_sheikah=eyJhbGciOiJIUzI... 。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "First Paragraph", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "b976d5d2f71c07c365d015cee04a06eb"}}, {"type": "UncategorizedText", "element_id": "f221e3473a874fc00cf703f02b3414bb", "text": "访问时间在 [2025-02-19 00:00:01, 2025-02-19 23:59:59]，访问 IP 是 127.0.0.1 的含敏感情况。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Body Text", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "b976d5d2f71c07c365d015cee04a06eb"}}, {"type": "ListItem", "element_id": "462c1157218ed10d2fe9d4867d2801dc", "text": "必填参数：name, start_ts, end_ts, ip", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Compact", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "b976d5d2f71c07c365d015cee04a06eb"}}, {"type": "ListItem", "element_id": "a249003774ccfcb71607403a0b92e16b", "text": "非必填参数：host, user", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "ffa3fe7e856c941c0d47d272d0834ad58f3ffa84560a5b1e99205ae4e6208f8a.docx", "last_modified": "2026-10-19T18:19:42", "style_name": "Compact", "languages": ["eng"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "b976d5d2f71c07c365d015cee04a06eb"}}]}