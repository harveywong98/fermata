{"blocks": [{"type": "UncategorizedText", "element_id": "6013d51bd2494e5801f33af7b417ae1f", "text": "API基础平台流量引入后初始配置流程", "metadata": {"category_depth": 0, "emphasized_text_contents": ["API基础平台流量引入后初始配置", "流程"], "emphasized_text_tags": ["b", "b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "PageBreak", "element_id": "b0ba0d5b0ec6d61477e90f95ba37ebb9", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "03f9d62c94c5cb1b0fc856d74a341c11", "text": "站点/应用梳理", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "9cb6dd30788e975e7876fbbd316f8f54", "text": "梳理TOP5站点，配置一个可读站点/应用名", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "03f9d62c94c5cb1b0fc856d74a341c11"}}, {"type": "UncategorizedText", "element_id": "66ae713c1719b40ad39b58e4669c2a36", "text": "相关流程入下：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "9cb6dd30788e975e7876fbbd316f8f54"}}, {"type": "ListItem", "element_id": "08b37afe4ee696cb2f562e9cec4fc555", "text": "1. 域名名称具有标志性可自行推断，如图表1，不好推断可询问客户", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "9cb6dd30788e975e7876fbbd316f8f54"}}, {"type": "ListItem", "element_id": "3cdf161562085f145aec2fbbc3c6aa10", "text": "2. ‘站点管理’中创建站点，输入相应名称即可，如图表2", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "9cb6dd30788e975e7876fbbd316f8f54"}}, {"type": "ListItem", "element_id": "4c3463981efe74f7dd206d2bb4e7f906", "text": "3. top5非严格限制，结合客户情况可自行斟酌", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "9cb6dd30788e975e7876fbbd316f8f54"}}, {"type": "UncategorizedText", "element_id": "6a48c73e406d7ec12e41ee23749f5972", "text": "图表 1", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "9cb6dd30788e975e7876fbbd316f8f54"}}, {"type": "UncategorizedText", "element_id": "01bed91c040e947d826956ff71bffff4", "text": "图表 2", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 2, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "9cb6dd30788e975e7876fbbd316f8f54"}}, {"type": "PageBreak", "element_id": "56b05af81a977ad70d9eb54c509ffc26", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "1d8672d45820940415d67338f8378cc0", "text": "站点/应用降噪", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "82d3e5e263c1a2d7e853d6d14526cdea", "text": "相关流程入下：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1d8672d45820940415d67338f8378cc0"}}, {"type": "ListItem", "element_id": "086459d78ef1622fa615bb9e99051074", "text": "1. 站点梳理完成后可联系客户，确定需要忽略的站点/应用", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1d8672d45820940415d67338f8378cc0"}}, {"type": "ListItem", "element_id": "a08b272ea729c255af5610abcdf60ebc", "text": "2. ‘业务配置’中新增业务，选择需要忽略的站点进行配置，如图表3", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1d8672d45820940415d67338f8378cc0"}}, {"type": "ListItem", "element_id": "5329ede86735638c660415f44a2992dd", "text": "3. 站点完成后即可点击‘防护配置’，对配置的站点业务进行忽略，如图表4", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1d8672d45820940415d67338f8378cc0"}}, {"type": "UncategorizedText", "element_id": "d637fa7750672f55a62845747196ea21", "text": "图表 3", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1d8672d45820940415d67338f8378cc0"}}, {"type": "UncategorizedText", "element_id": "dbac3b547b142dbc60c0e340fc5a2bb9", "text": "图表 4", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 3, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1d8672d45820940415d67338f8378cc0"}}, {"type": "PageBreak", "element_id": "aaafd0a5b613a90e330422b2af70dece", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "891a4ea7ed7f691043764ba76a60946e", "text": "API合并", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "da50bc4415681923939eebe1e8bc0a9d", "text": "合并重复的API，降低统计压力", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "891a4ea7ed7f691043764ba76a60946e"}}, {"type": "UncategorizedText", "element_id": "cb5ec8bbf0ab65b59211f21432d61785", "text": "合并API项注意事项", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "ListItem", "element_id": "fcd546f422856bcae126b11b40325ade", "text": "1. 列举API重复合并项特征明显，点击‘合并’即可，如下图表5", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "ListItem", "element_id": "5da436d8609069f45825df686aeb2cad", "text": "2. 列举的API数量级较大，合并页API数量从高到低排序，优先考虑排名靠前者", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "ListItem", "element_id": "254d00c6d7eb3f7871d87d0b84825e43", "text": "3. 合并错误可前往‘策略管理’-‘业务配置’中删除配置项，如图表6", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "ListItem", "element_id": "ac12f1b44aedeb7083d6094c1fa065d4", "text": "4. 若能确定API中类似id位置，可在‘业务配置’中自行配置，示例如下图表6", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "ListItem", "element_id": "6ae8c15d638191f8b4086712ccc923d8", "text": "/c/msdownload/update/other/2023/04/{id} 这个 API 业务以日期为作为资源，描述可替换为下方 /c/msdownload/update/other/{id}/{id}/{id}", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "UncategorizedText", "element_id": "560b32441711cc9518dcefe79c81aaf6", "text": "图表 5", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "UncategorizedText", "element_id": "cd509aeef0ea88d856b5064a9a40dc14", "text": "图表 6", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 4, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "da50bc4415681923939eebe1e8bc0a9d"}}, {"type": "PageBreak", "element_id": "8cdcf6ddb1625d15743af64065ce0e50", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "f79154c3ee753f0f6d0e73917e3400fc", "text": "隐私准确性", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "0bfb2e47c39f9c111289cd93dbeb5d7d", "text": "如果有大量误报，需要调整开关关闭，或单项排除", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "f79154c3ee753f0f6d0e73917e3400fc"}}, {"type": "UncategorizedText", "element_id": "4014deb3a7733d93debdda6e28a579ea", "text": "相关排查流程：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "0bfb2e47c39f9c111289cd93dbeb5d7d"}}, {"type": "ListItem", "element_id": "6467fb269ea3ae99a21d6daf65ca79f2", "text": "1. 优先排查‘敏感数据统计’中次数排名靠前的统计项，如图表7", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "0bfb2e47c39f9c111289cd93dbeb5d7d"}}, {"type": "ListItem", "element_id": "32647eb47ae667d5551695ecb762826c", "text": "2. 通过详情查看命中敏感数据项API的报文详情和命中详情，如图表8", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "0bfb2e47c39f9c111289cd93dbeb5d7d"}}, {"type": "ListItem", "element_id": "eb4f4f753421c82ec23513823cd8b02c", "text": "3. 确认命中敏感数据项是否准确，发现命中错误，命中项为单一值并重复出现可点击‘忽略’，忽略该数据的命中，如图表8", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "0bfb2e47c39f9c111289cd93dbeb5d7d"}}, {"type": "UncategorizedText", "element_id": "68ee97b2f6924414a6e5c91a3970b23a", "text": "图表 7", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "0bfb2e47c39f9c111289cd93dbeb5d7d"}}, {"type": "UncategorizedText", "element_id": "446eb97a74733a92a9f854798e7a043f", "text": "图表 8", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 5, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "0bfb2e47c39f9c111289cd93dbeb5d7d"}}, {"type": "PageBreak", "element_id": "1dd07d9533df850ebbd7a51b094ef39f", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "bdc3af1ae173a80b5ed8aba64bb8f1e2", "text": "鉴权分析（非必要项）", "metadata": {"category_depth": 1, "emphasized_text_contents": ["鉴权分析", "（非必要项）"], "emphasized_text_tags": ["b", "b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "8340e43a8e0b851b6a7a8d28dcc8ac28", "text": "获得用户信息，配置UserToken自定义参数", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "bdc3af1ae173a80b5ed8aba64bb8f1e2"}}, {"type": "UncategorizedText", "element_id": "155f28cfdbaf6d75db98460c357567f9", "text": "     相关流程如下：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8340e43a8e0b851b6a7a8d28dcc8ac28"}}, {"type": "ListItem", "element_id": "02b48585963df67a1070e45288a22d9f", "text": "1. 根据‘API资产管理’-‘分组概览’中的登录模块的API 前往‘访问清单’查看请求报文，如图表9", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8340e43a8e0b851b6a7a8d28dcc8ac28"}}, {"type": "ListItem", "element_id": "27f4fd0f9bf6760c6fd316a5751b3510", "text": "2. 查看报文中中符合登录标识的字段，例如uid,username,name等，并确定其参数在报文中位置，如图表10中登录标识位置在BodyMap/identifier", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8340e43a8e0b851b6a7a8d28dcc8ac28"}}, {"type": "ListItem", "element_id": "7921bec1ddbd99a64ed67c156eb794bd", "text": "3. 在‘策略管理’-‘实时规则’添加自定义参数，参数名称为UserToken，参数位置则为登录标识的字段在报文中的位置，可添加多个，如图表11", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8340e43a8e0b851b6a7a8d28dcc8ac28"}}, {"type": "UncategorizedText", "element_id": "c2a1f00f22d4e99c71ce8d811541b3b5", "text": "图表 9", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8340e43a8e0b851b6a7a8d28dcc8ac28"}}, {"type": "UncategorizedText", "element_id": "1a51fd9f8b3c6021361fb82e2be9d4fd", "text": "图表 10", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 6, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "8340e43a8e0b851b6a7a8d28dcc8ac28"}}, {"type": "PageBreak", "element_id": "d229e7d0e1c3e442493eb2104e2a5d18", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "09fc441eaae305419d0660645534e867", "text": "图表 11", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 7, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "17b009c6b13f51997c7b29031900cc41", "text": "UserToken含义", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 7, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "ListItem", "element_id": "ec8c8900530ea51b710e1f76532432ed", "text": "1. UserToken是作为用户标识定义字段使用，可在‘访问清单’中开启查看，如图表12", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 7, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "17b009c6b13f51997c7b29031900cc41"}}, {"type": "ListItem", "element_id": "268ba7367b2fd3f9e8a367460c979c07", "text": "2. UserToken配置后平台会根据相应规则抓取相应的数据填充到用户标识中", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 7, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "17b009c6b13f51997c7b29031900cc41"}}, {"type": "ListItem", "element_id": "26bbd85d5a5eb83c35e5eb20a95a2f57", "text": "3. 抓取到相应的用户标识，平台即可根据用户标识对相应的用户进行下钻分析，如图表13", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 7, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "17b009c6b13f51997c7b29031900cc41"}}, {"type": "UncategorizedText", "element_id": "f6eac6d5fa4759248c52d94bdedd972d", "text": "图表 12", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 7, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "17b009c6b13f51997c7b29031900cc41"}}, {"type": "PageBreak", "element_id": "3ce802a84f497cc32f4a8c04745818bd", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "0b1e55126d7a5d0dc9ee533445427b45", "text": "图表 13", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "853dad1a98c7756bc12636ef4b800277", "text": "高风险隐私排查（非必要项）", "metadata": {"category_depth": 1, "emphasized_text_contents": ["高风险", "隐私", "排查", "（非必要项）"], "emphasized_text_tags": ["b", "b", "b", "b"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "cfaf3f6c5382445036f28acc47c4b58a", "text": "响应含有隐私，但缺少鉴权的API，视为高风险API", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "853dad1a98c7756bc12636ef4b800277"}}, {"type": "UncategorizedText", "element_id": "bdb3e7f26466b1df4403a30bfe6a407b", "text": "相关排查流程：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "ListItem", "element_id": "e1bd215070cb6948155c5ec052f1ca01", "text": "1. ‘敏感数据统计’中‘响应’包含敏感数据项重点关注，如图表14", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "ListItem", "element_id": "6e02925f57369c6e96daee29ccbfb68a", "text": "2. 查看详情确定命中项是否正确并且泄露危害严重，则确定其API，如图表15", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "ListItem", "element_id": "1be00a4d5b6eb9c1ab8d42797e3160b8", "text": "3. 根据API前往‘访问请求’查看‘请求’中是否包含类似相关鉴权参数，如图表16，图表17", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "ListItem", "element_id": "52e24bd06c62a0801ee079dc7c994b9b", "text": "4. 类似鉴权参数可查看‘请求’报文中是否包含session,cookie,token等常用鉴权标识", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "ListItem", "element_id": "d1500e16f29b4526bd61293a0f2adfd8", "text": "5. 若无相关类似鉴权参数可联系研发进行查看", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "UncategorizedText", "element_id": "fb9e3209b0ce7c2740289fd40506e735", "text": "图表 14", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "UncategorizedText", "element_id": "d9df72470136b8d19535d65e7b331707", "text": "图表 15", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "UncategorizedText", "element_id": "070cc3507100185b0dbe3f3ac7a85582", "text": "图表 16", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}, {"type": "UncategorizedText", "element_id": "21caa3d68be328c90f9a73c730f0d38e", "text": "图表 17", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "5169608171f070318f7326d69bf4083910c6df77297c4e118ebab09860d859ce.docx", "last_modified": "2024-04-18T18:34:30", "page_number": 8, "style_name": "Caption", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "cfaf3f6c5382445036f28acc47c4b58a"}}]}