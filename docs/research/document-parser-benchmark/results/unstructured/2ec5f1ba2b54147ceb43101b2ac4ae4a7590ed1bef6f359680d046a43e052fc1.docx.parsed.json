{"blocks": [{"type": "Title", "element_id": "54dae7a6a62e295f4a6c54d024cd0046", "text": "山东航空", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Heading 1", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "f7498dbd4fa4c66f3b1821890877e216", "text": "目标：敏感数据泄漏风险排查", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "54dae7a6a62e295f4a6c54d024cd0046"}}, {"type": "UncategorizedText", "element_id": "b00a915e2770fec1276387780806599b", "text": "流量：公网（南北向） / 内网 （东西向） 混合", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "54dae7a6a62e295f4a6c54d024cd0046"}}, {"type": "Title", "element_id": "c5fd916c7f424b245b0b1367c3b4e3d4", "text": "1. 准备工作：接入流量【完成】", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "54dae7a6a62e295f4a6c54d024cd0046"}}, {"type": "UncategorizedText", "element_id": "a5591b681eea60feeaea5f729442160d", "text": "验证流量成分：数据溯源功能", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "c5fd916c7f424b245b0b1367c3b4e3d4"}}, {"type": "UncategorizedText", "element_id": "64adfad5ef7668f0ad8a6553a3b01d70", "text": "溯源访问者，根据IP：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "c5fd916c7f424b245b0b1367c3b4e3d4"}}, {"type": "UncategorizedText", "element_id": "f12b31464ece9431ef213bafaa4d6723", "text": "溯源特定数据：值机手机号", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "c5fd916c7f424b245b0b1367c3b4e3d4"}}, {"type": "UncategorizedText", "element_id": "43334dd4b3a57f16779368ddd1c69995", "text": "2024-4-16 上午11点13分", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "c5fd916c7f424b245b0b1367c3b4e3d4"}}, {"type": "UncategorizedText", "element_id": "00160834e3794034ccb700b799a496ae", "text": "https://www.sda.cn/checkin/agreement.shtml?idType=PP&idNo=111&mobileNo=18601121116&idName=111&flightNo=111&orgId=SCAIR&language=CN", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "link_texts": ["https://www.sda.cn/checkin/agreement.shtml?idType=PP&idNo=111&mobileNo=18601121116&idName=111&flightNo=111&orgId=SCAIR&language=CN"], "link_urls": ["https://www.sda.cn/checkin/agreement.shtml?idType=PP&idNo=111&mobileNo=18601121116&idName=111&flightNo=111&orgId=SCAIR&language=CN"], "links": [{"text": "https://www.sda.cn/checkin/agreement.shtml?idType=PP&idNo=111&mobileNo=18601121116&idName=111&flightNo=111&orgId=SCAIR&language=CN", "url": "https://www.sda.cn/checkin/agreement.shtml?idType=PP&idNo=111&mobileNo=18601121116&idName=111&flightNo=111&orgId=SCAIR&language=CN", "start_index": 0}], "page_number": 1, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "c5fd916c7f424b245b0b1367c3b4e3d4"}}, {"type": "PageBreak", "element_id": "95ed73bf84a3a30aacd30ff8383ae47d", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "51e996a4f4822da3b0485174c1ebf85e", "text": "2. 定义边界：暴漏面分析", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "95e6f7fa0fbf86cdb7995d5113a17c3d", "text": "数据暴漏面确定，主要是需要对网络流量分析，配置公网内网，确定边界后。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "51e996a4f4822da3b0485174c1ebf85e"}}, {"type": "UncategorizedText", "element_id": "5fa3f4cfd617eff50e24d44625ff4fdd", "text": "可以确定数据流动方向和可能的暴漏点。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "51e996a4f4822da3b0485174c1ebf85e"}}, {"type": "Title", "element_id": "a4cde5a49a506a09a1916e0475981d74", "text": "2.1 内网梳理【完成】", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "51e996a4f4822da3b0485174c1ebf85e"}}, {"type": "UncategorizedText", "element_id": "dce7b42b1e2893478ebc8e8e32ba0b1e", "text": "内网IP判定：经过分析，内网主要是172网段等标准局域网网段", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a4cde5a49a506a09a1916e0475981d74"}}, {"type": "UncategorizedText", "element_id": "3af9e642f9e1cacb88c83fb2a17049e6", "text": "配置后客户端地域会正确分类，未配置的172.23默认为局域网", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a4cde5a49a506a09a1916e0475981d74"}}, {"type": "UncategorizedText", "element_id": "171171ffd9981e6a9076bb49653b0b7d", "text": "外发 / 内网 / 公网的筛选", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 2, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a4cde5a49a506a09a1916e0475981d74"}}, {"type": "PageBreak", "element_id": "490a1ceac5861f0c38433e9f79087184", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "123bda4abe504fe395337f2536d575e2", "text": "内网公网配置后，可以准确确定流量的网络类型：内网/外网/外发。并自动降低内网间风险。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 3, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "c5a0447f9069b8bd41cbc73cada18a7a", "text": "2.2 数据流向【手机号】", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 3, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "38c29832c71fd0e3d308b168842a44db", "text": "个人信息中手机号泄漏，会产生最直接的客户骚扰，欺诈风险。POC阶段优先分析手机号。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 3, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "c5a0447f9069b8bd41cbc73cada18a7a"}}, {"type": "Title", "element_id": "734830bcef6a8acfb1a846e2f0c34f0d", "text": "3.2 应用梳理【完成】", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 3, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "PageBreak", "element_id": "a9db8050d7a7d509ea36a6fb9620c97a", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "b47c6fa6280ec6d659bc288a4e4c1efb", "text": "进行应用于业务分析，对于含有【手机号】服务器信息等多个角度，对top应用/域名进行重点关注：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "50be60204b21c65447b44cfa8e3d6b68", "text": "经过排查，有非常多应用含有手机号，并且可以返回给用户。需要对至少TOP 10做进一步梳理与鉴权分析（确定使用者）。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "a15b71f37cf8b767b18d1c015dc6f45d", "text": "3. 定义角色：使用者分析【进行中】", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "2e748647066b27d335314f57c1fc9b1e", "text": "对数据在边界上进行基于角色的量化的管控：", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a15b71f37cf8b767b18d1c015dc6f45d"}}, {"type": "ListItem", "element_id": "5e5d32a583226a15f8975d029f5be154", "text": "来自公网请求：如果API响应携带了敏感数据，需要量化管控。这里可能分成2B，2C两类用户。（及终端用户，客票代理等）", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a15b71f37cf8b767b18d1c015dc6f45d"}}, {"type": "ListItem", "element_id": "d83f1606140a3a267e234c44e3c8426e", "text": "内网之间请求：如果API在系统内部传输数据，默认风险优先级降低，先进行排除。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a15b71f37cf8b767b18d1c015dc6f45d"}}, {"type": "ListItem", "element_id": "95165d4db300b6300382c73207fc82d1", "text": "外发API：如果系统对接合作方API，如航信API调用，这时敏感数据携带在请求中。应该区分并量化管控。个人外发数据，应该进行基于身份鉴权进行管控。", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "List Paragraph", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a15b71f37cf8b767b18d1c015dc6f45d"}}, {"type": "Title", "element_id": "fa3298ed8a5d4cd80001d1eb27d78413", "text": "3.1 用户梳理", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 4, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "a15b71f37cf8b767b18d1c015dc6f45d"}}, {"type": "PageBreak", "element_id": "d4bb5179f99accdfa00d42c357043da5", "text": "", "metadata": {"languages": ["zho"], "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Title", "element_id": "f9ae4af93a0866faecadafc6029b4b2a", "text": "3.2 鉴权梳理", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "Table", "element_id": "971080a65675e736b27f02b0dd1fa627", "text": "用户类型 业务 鉴权字段 其他信息 ly.sda.cn 移动端 Restful API查询乘客信息，订餐 Body.token Body.ssoToken https://ly.sda.cn/meal/#/", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "text_as_html": "<table><tr><td/><td>用户类型</td><td>业务</td><td>鉴权字段</td><td>其他信息</td></tr><tr><td>ly.sda.cn</td><td>移动端</td><td>Restful API查询乘客信息，订餐</td><td>Body.token Body.ssoToken</td><td>https://ly.sda.cn/meal/#/</td></tr><tr><td/><td/><td/><td/><td/></tr><tr><td/><td/><td/><td/><td/></tr></table>", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "f9ae4af93a0866faecadafc6029b4b2a"}}, {"type": "Title", "element_id": "1f629f4f22ae515cbd6ad89c63f4ee22", "text": "4. 定义用量：运营视角分析【未完成】", "metadata": {"category_depth": 1, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "style_name": "Heading 2", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"}}, {"type": "UncategorizedText", "element_id": "b449b3a1ae8d269d031b2e7b63a88c98", "text": "对关键API用户粒度访问量，IP粒度访问量进行分析，排除异常", "metadata": {"category_depth": 0, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "style_name": "Normal", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1f629f4f22ae515cbd6ad89c63f4ee22"}}, {"type": "Table", "element_id": "b2f9fe52bc41602bc131e20a70a1cb93", "text": "API 用户访问量 IP访问量 ly.sda.cn /air-rest/app-api/passenger/list 小于30次/12小时 小于200次/12小时", "metadata": {"file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "text_as_html": "<table><tr><td/><td>API</td><td>用户访问量</td><td>IP访问量</td><td/></tr><tr><td>ly.sda.cn</td><td>/air-rest/app-api/passenger/list</td><td>小于30次/12小时</td><td>小于200次/12小时</td><td/></tr><tr><td/><td/><td/><td/><td/></tr><tr><td/><td/><td/><td/><td/></tr></table>", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1f629f4f22ae515cbd6ad89c63f4ee22"}}, {"type": "Title", "element_id": "bcd13955a5a179e01fee6250e62b9238", "text": "4.1 数据用量可视化指标", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1f629f4f22ae515cbd6ad89c63f4ee22"}}, {"type": "Title", "element_id": "c46da34f083a700f8f032f0683279afe", "text": "4.2 业务级告警规则", "metadata": {"category_depth": 2, "file_directory": "/Users/mac/Developer/src/python/privacy-react-demo/research/document-parser-benchmark/corpus/docx", "filename": "2ec5f1ba2b54147ceb43101b2ac4ae4a7590ed1bef6f359680d046a43e052fc1.docx", "last_modified": "2024-04-16T19:29:45", "page_number": 5, "style_name": "Heading 3", "languages": ["zho"], "filetype": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "parent_id": "1f629f4f22ae515cbd6ad89c63f4ee22"}}]}